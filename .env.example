# Meta Pixel (Dockerfile lo pasa como build arg)
NEXT_PUBLIC_META_PIXEL_ID=

# PostHog (analítica). Token del proyecto en PostHog → Settings → Project.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Backend de Clidenta usado por el proxy server-side del formulario de leads.
LEADS_API_URL=https://api.clidenta.net
